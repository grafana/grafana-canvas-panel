    "infinite-viewer": "^0.29.1",
    "moveable": "0.53.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-draggable": "4.5.0",
    "react-inlinesvg": "4.3.0",
    "react-moveable": "0.56.0",
    "react-resizable": "3.0.5",
    "react-virtualized-auto-sizer": "1.0.26",
    "react-window": "1.8.11",
    "selecto": "1.26.3"
  },
  "packageManager": "npm@11.6.1"
