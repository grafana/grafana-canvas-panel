{
  "name": "canvas",
  "version": "13.2.0",
  "scripts": {
    "build": "webpack -c ./webpack.config.ts --env production",
    "dev": "webpack -w -c ./webpack.config.ts --env development",
    "generate-img-manifests": "node scripts/generate-img-manifests.mjs",
    "prebuild": "npm run generate-img-manifests",
    "test": "jest --watch --onlyChanged && npm run test:scripts",
    "test:ci": "jest --passWithNoTests --maxWorkers 4 && npm run test:scripts",
    "test:scripts": "node --test scripts/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --cache .",
    "spellcheck": "cspell .",
    "lint:fix": "npm run lint -- --fix && prettier --write --list-different .",
    "e2e": "PLAYWRIGHT_VERSION=$(node -p \"require('./package.json').devDependencies['@playwright/test']\") docker compose --profile playwright run --rm playwright",
    "e2e:ui": "npx playwright test --ui",
    "server": "docker compose up --build",
    "sign": "sign-plugin"
  },
  "author": "Grafana",
  "license": "AGPL-3.0-only",
  "devDependencies": {
    "@grafana/eslint-config": "9.0.0",
    "@grafana/plugin-e2e": "3.10.0",
    "@grafana/sign-plugin": "3.3.3",
    "@grafana/tsconfig": "2.2.0",
    "@playwright/test": "1.56.1",
    "@stylistic/eslint-plugin-ts": "4.4.1",
    "@swc/core": "1.15.43",
    "@swc/helpers": "0.5.23",
    "@swc/jest": "0.2.39",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/jest": "29.5.14",
    "@types/node": "24.13.3",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/react-resizable": "4.0.0",
    "@types/react-window": "1.8.8",
    "@typescript-eslint/eslint-plugin": "8.64.0",
    "@typescript-eslint/parser": "8.64.0",
    "copy-webpack-plugin": "13.0.1",
    "cspell": "10.0.1",
    "css-loader": "7.1.4",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsdoc": "52.0.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-webpack-plugin": "5.0.3",
    "fork-ts-checker-webpack-plugin": "9.1.0",
    "glob": "11.1.0",
